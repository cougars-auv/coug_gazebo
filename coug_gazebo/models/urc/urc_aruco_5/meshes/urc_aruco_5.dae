<?xml version="1.0" encoding="utf-8"?>
<COLLADA xmlns="http://www.collada.org/2005/11/COLLADASchema" version="1.4.1">
  <asset>
    <unit name="meter" meter="1"/>
    <up_axis>Z_UP</up_axis>
  </asset>
  <library_images>
    <image id="marker-image" name="marker-image">
      <init_from>urc_aruco_5.png</init_from>
    </image>
  </library_images>
  <library_effects>
    <effect id="marker-effect">
      <profile_COMMON>
        <newparam sid="marker-surface">
          <surface type="2D">
            <init_from>marker-image</init_from>
          </surface>
        </newparam>
        <newparam sid="marker-sampler">
          <sampler2D>
            <source>marker-surface</source>
          </sampler2D>
        </newparam>
        <technique sid="common">
          <lambert>
            <diffuse>
              <texture texture="marker-sampler" texcoord="UVMap"/>
            </diffuse>
          </lambert>
        </technique>
      </profile_COMMON>
    </effect>
  </library_effects>
  <library_materials>
    <material id="marker-material" name="marker-material">
      <instance_effect url="#marker-effect"/>
    </material>
  </library_materials>
  <library_geometries>
    <geometry id="prism-mesh" name="prism">
      <mesh>
        <source id="prism-positions">
          <float_array id="prism-positions-array" count="18">-0.1 -0.05773503 0 0.1 -0.05773503 0 -0.1 -0.05773503 0.2 0.1 -0.05773503 0.2 0 0.1154701 0 0 0.1154701 0.2</float_array>
          <technique_common>
            <accessor source="#prism-positions-array" count="6" stride="3">
              <param name="X" type="float"/>
              <param name="Y" type="float"/>
              <param name="Z" type="float"/>
            </accessor>
          </technique_common>
        </source>
        <source id="prism-normals">
          <float_array id="prism-normals-array" count="15">0 -1 0 0.8660254 0.5 0 -0.8660254 0.5 0 0 0 -1 0 0 1</float_array>
          <technique_common>
            <accessor source="#prism-normals-array" count="5" stride="3">
              <param name="X" type="float"/>
              <param name="Y" type="float"/>
              <param name="Z" type="float"/>
            </accessor>
          </technique_common>
        </source>
        <source id="prism-uvs">
          <float_array id="prism-uvs-array" count="10">0 0 1 0 1 1 0 1 0.05 0.05</float_array>
          <technique_common>
            <accessor source="#prism-uvs-array" count="5" stride="2">
              <param name="S" type="float"/>
              <param name="T" type="float"/>
            </accessor>
          </technique_common>
        </source>
        <vertices id="prism-vertices">
          <input semantic="POSITION" source="#prism-positions"/>
        </vertices>
        <triangles material="marker-material" count="8">
          <input semantic="VERTEX" source="#prism-vertices" offset="0"/>
          <input semantic="NORMAL" source="#prism-normals" offset="1"/>
          <input semantic="TEXCOORD" source="#prism-uvs" offset="2" set="0"/>
          <p>0 0 0 1 0 1 3 0 2 0 0 0 3 0 2 2 0 3 1 1 0 4 1 1 5 1 2 1 1 0 5 1 2 3 1 3 4 2 0 0 2 1 2 2 2 4 2 0 2 2 2 5 2 3 0 3 4 4 3 4 1 3 4 2 4 4 3 4 4 5 4 4</p>
        </triangles>
      </mesh>
    </geometry>
  </library_geometries>
  <library_visual_scenes>
    <visual_scene id="scene" name="scene">
      <node id="prism" name="prism" type="NODE">
        <instance_geometry url="#prism-mesh" name="prism">
          <bind_material>
            <technique_common>
              <instance_material symbol="marker-material" target="#marker-material">
                <bind_vertex_input semantic="UVMap" input_semantic="TEXCOORD" input_set="0"/>
              </instance_material>
            </technique_common>
          </bind_material>
        </instance_geometry>
      </node>
    </visual_scene>
  </library_visual_scenes>
  <scene>
    <instance_visual_scene url="#scene"/>
  </scene>
</COLLADA>
