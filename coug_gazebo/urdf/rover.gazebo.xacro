<robot name="rover_gazebo" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:arg name="agent_ns" default="rover1gz" />
  <xacro:property name="agent_ns" value="$(arg agent_ns)" />

  <xacro:arg name="tf_prefix" default="$(arg agent_ns)/" />

  <xacro:include filename="$(find coug_description)/urdf/rover.urdf.xacro" />
  <xacro:include filename="$(find coug_gazebo)/urdf/sensors.gazebo.xacro" />

  <!-- TODO: Add wheel friction that matches the real rover better -->
  <xacro:macro name="wheel_friction" params="prefix">
    <gazebo reference="${tf_prefix}${prefix}_wheel_link">
      <mu1>1.0</mu1>
      <mu2>0.5</mu2>
      <fdir1>1 0 0</fdir1>
    </gazebo>
  </xacro:macro>

  <xacro:wheel_friction prefix="front_left" />
  <xacro:wheel_friction prefix="front_right" />
  <xacro:wheel_friction prefix="middle_left" />
  <xacro:wheel_friction prefix="middle_right" />
  <xacro:wheel_friction prefix="rear_left" />
  <xacro:wheel_friction prefix="rear_right" />

  <!-- Gazebo plugins -->
  <gazebo>
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>front_left_wheel_joint</left_joint>
      <left_joint>middle_left_wheel_joint</left_joint>
      <left_joint>rear_left_wheel_joint</left_joint>
      <right_joint>front_right_wheel_joint</right_joint>
      <right_joint>middle_right_wheel_joint</right_joint>
      <right_joint>rear_right_wheel_joint</right_joint>
      <wheel_separation>${2*wheel_yoff}</wheel_separation>
      <wheel_radius>${wheel_radius}</wheel_radius>
      <topic>/${agent_ns}/cmd_vel</topic>
      <odom_topic>/${agent_ns}/wheel/odom</odom_topic>
      <child_frame_id>${tf_prefix}base_link</child_frame_id>
    </plugin>

    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
      <topic>/${agent_ns}/joint_states</topic>
    </plugin>

    <xacro:truth_odometry base_frame="${tf_prefix}base_link" />

    <xacro:camera_odometry camera_frame="${tf_prefix}depth_camera_link" xyz="${rover_depth_camera_xyz}" rpy="${rover_depth_camera_rpy}" />
  </gazebo>

  <!-- Gazebo sensors -->
  <xacro:imu_sensors link="${tf_prefix}imu_link" />
  <xacro:gps_sensor link="${tf_prefix}gps_link" />
  <xacro:depth_camera_sensor link="${tf_prefix}depth_camera_link" />

</robot>
