<sdf version="1.9" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:arg name="headless" default="true" />

  <xacro:include filename="world_common.xacro" />

  <world name="default">
    <xacro:world_systems headless="$(arg headless)" />
    <xacro:world_origin latitude="38.418" longitude="-110.777" elevation="1394.024" />
    <xacro:sun />
    <scene>
      <sky />
    </scene>
    <xacro:heightmap_physics />

    <xacro:heightmap_terrain
      name="urc_terrain"
      dir="$(find coug_gazebo)/models/urc_terrain"
      size="2000.0 2000.0 85.71"
      z="-48.88"
    />
  </world>
</sdf>
