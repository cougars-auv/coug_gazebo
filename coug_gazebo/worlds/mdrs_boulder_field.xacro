<sdf version="1.9" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:property name="rocks_dir" value="$(find coug_gazebo)/models/urc/rocks/meshes" />

  <xacro:macro name="rock" params="name mesh pose scale color">
    <link name="${name}">
      <pose>${pose}</pose>
      <collision name="collision">
        <geometry>
          <mesh>
            <uri>${rocks_dir}/rock_${mesh}.obj</uri>
            <scale>${scale}</scale>
          </mesh>
        </geometry>
      </collision>
      <visual name="visual">
        <geometry>
          <mesh>
            <uri>${rocks_dir}/rock_${mesh}.obj</uri>
            <scale>${scale}</scale>
          </mesh>
        </geometry>
        <material>
          <ambient>${color} 1</ambient>
          <diffuse>${color} 1</diffuse>
        </material>
      </visual>
    </link>
  </xacro:macro>

